# --- PayPal (Dashboard Developer -> Apps & Credentials) ---
# Client ID pubblico: usato anche dal browser per renderizzare i pulsanti PayPal.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# Secret dell'app PayPal: SOLO lato server.
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# "sandbox" (default) oppure "live" in produzione.
PAYPAL_ENV=sandbox

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
# Service role key: SOLO lato server, bypassa la RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin ---
# Chiave per la rotta protetta GET /api/admin/prevendite.
ADMIN_API_KEY=scegli-una-chiave-lunga-e-casuale

# --- Evento ---
# Indirizzo esatto del festino, mostrato solo dopo il pagamento.
# Se omesso viene usato il valore di default in lib/secret.ts.
PARTY_SECRET_ADDRESS="Via Lodovico il Moro 27, 20143 Milano (MI) — Citofono 8, 3° piano"
