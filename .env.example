# Chiave segreta Stripe (Dashboard -> Developers -> API keys)
# Usa la chiave di test (sk_test_...) durante lo sviluppo.
STRIPE_SECRET_KEY=sk_test_xxx

# URL pubblico dell'app: usato come fallback per i redirect di Stripe
# quando l'header Origin non è disponibile.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Indirizzo esatto del festino, mostrato solo dopo il pagamento.
# Se omesso viene usato il valore di default in lib/secret.ts.
PARTY_SECRET_ADDRESS="Via Lodovico il Moro 27, 20143 Milano (MI) — Citofono 8, 3° piano"
